<Project>
  <!-- Phiên bản package dùng chung cho cả solution. Chỉ sửa phiên bản ở file này.
       Thêm package mới: thêm PackageVersion ở đây + PackageReference (không có Version) ở csproj. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.32" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.32" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.32" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.32" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.32" />
    <PackageVersion Include="Microsoft.AspNetCore.OData" Version="8.3.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>
</Project>
