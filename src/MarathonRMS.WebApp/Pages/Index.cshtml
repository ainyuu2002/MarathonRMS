@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}
<section class="p-4 p-md-5 mb-4 rounded-3 bg-body-tertiary border">
    <h1 class="display-6 fw-semibold">Marathon Race Management System</h1>
    <p class="lead mb-4">Nền tảng đăng ký và quản lý giải chạy cho nhiều ban tổ chức – giải đường phố và trail.</p>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-warning btn-lg me-2" asp-page="/Account/Register">Tạo tài khoản</a>
        <a class="btn btn-outline-secondary btn-lg" asp-page="/Account/Login">Đăng nhập</a>
    }
</section>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Giải sắp diễn ra</h2>
    <a asp-page="/Events/Index" class="btn btn-outline-primary btn-sm">Tất cả giải <i class="bi bi-arrow-right"></i></a>
</div>
@if (Model.ApiUnavailable)
{
    <div class="alert alert-warning">Chưa tải được danh sách giải. Vui lòng thử lại sau.</div>
}
else if (Model.Upcoming.Count == 0)
{
    <div class="text-center text-secondary border rounded py-5">Chưa có giải sắp diễn ra.</div>
}
<div class="row g-3">
    @foreach (var e in Model.Upcoming)
    {
        <div class="col-sm-6 col-lg-4 col-xl-3"><partial name="_EventCard" model="e" /></div>
    }
</div>
