@page
@{
    ViewData["Title"] = "Khu vực của tôi";
    var cards = new[]
    {
        new NavCard("Hồ sơ của tôi", "Thông tin người chạy, liên hệ khẩn cấp, đồng ý dữ liệu", "bi-person-vcard", "/Member/Profile"),
        new NavCard("Hồ sơ thành tích", "Các giải đã chạy, thành tích tốt nhất, e-certificate", "bi-trophy", "/Member/Achievements"),
        new NavCard("Khiếu nại kết quả", "Khiếu nại đã gửi và trả lời của ban tổ chức", "bi-chat-left-text", "/Member/Complaints"),
        new NavCard("Đăng ký làm Ban tổ chức", "Tổ chức giải chạy trên hệ thống bằng tài khoản này", "bi-building-add", "/Member/BecomeOrganizer"),
        new NavCard("Đăng ký của tôi", "Giải đã đăng ký, thanh toán, BIB, mã QR nhận race kit", "bi-ticket-perforated", "/Member/Registrations"),
