@page
@model MarathonRMS.WebApp.Pages.Member.RegistrationsModel
@{
    ViewData["Title"] = "Đăng ký của tôi";
}

<h1 class="h3 mb-3">Đăng ký của tôi</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.Items.Count == 0)
{
    <div class="text-center text-secondary border rounded py-5">
        <i class="bi bi-ticket-perforated fs-1"></i>
        <p class="mt-2 mb-0">Bạn chưa đăng ký giải nào.</p>
    </div>
}
<div class="row g-3">
    @foreach (var r in Model.Items)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 @(r.Status == "PendingPayment" ? "border-warning" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-semibold">@r.EventName</div>
                            <div class="small text-secondary">@r.EventDate.ToString("dd/MM/yyyy") · @r.CategoryName</div>
                        </div>
                        <status-badge status="@r.Status" />
                    </div>
                    <div class="mt-2 small">
                        Người chạy: <strong>@r.RunnerName</strong>@(r.IsDependent ? " (người phụ thuộc)" : "")
                        · BIB in tên: @r.BibName
                    </div>
                    <div class="small">Phí: @(r.FinalPrice == 0 ? "Miễn phí" : r.FinalPrice.ToString("N0") + "đ")</div>

                    @if (r.Status == "PendingPayment" && r.ExpiresAt is DateTime exp)
                    {
                        <div class="alert alert-warning py-2 small mt-2 mb-0">Giữ chỗ đến <strong>@exp.ToString("HH:mm dd/MM")</strong> – quá hạn sẽ tự hủy.</div>
                    }
                    @if (r.Status == "Confirmed")
                    {
                        <div class="d-flex align-items-center gap-3 mt-3">
                            <div class="qr border rounded p-1 bg-white" data-qr="@r.QrToken" style="width:104px;height:104px"></div>
                            <div class="small">
                                @if (r.BibNumber is int bib) { <div class="fs-4 fw-bold">BIB @bib</div> }
                                else { <div class="text-secondary">Chưa có số BIB</div> }
                                <div>@(r.RaceKitCollected ? "Đã nhận race kit" : "Đưa mã QR này khi nhận race kit")</div>
                                <div class="font-monospace text-secondary text-break">@r.QrToken</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex gap-2 flex-wrap">
                    @if (r.Status == "PendingPayment" && r.CanCancel)
                    {
                        <form method="post" asp-page-handler="Pay">
                            <input type="hidden" name="registrationId" value="@r.Id" />
                            <button class="btn btn-sm btn-primary"><i class="bi bi-credit-card"></i> Thanh toán (thử)</button>
                        </form>
                        <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Hủy đăng ký này?');">
                            <input type="hidden" name="registrationId" value="@r.Id" />
                            <button class="btn btn-sm btn-outline-danger">Hủy</button>
                        </form>
                    }
                    @if (r.Status == "Confirmed" && !r.RaceKitCollected && r.EventDate > DateOnly.FromDateTime(DateTime.Today))
                    {
                        <a asp-page="/Member/RegistrationChange" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left-right"></i> Chuyển nhượng / đổi cự ly</a>
                    }
                    @if (r.CanEditInfo)
                    {
                        <a asp-page="/Member/RegistrationEdit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Sửa thông tin</a>
                    }
                    @if (r.Status == "Confirmed" && r.EventDate <= DateOnly.FromDateTime(DateTime.Today))
                    {
                        <a asp-page="/Results/Detail" asp-route-registrationId="@r.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-stopwatch"></i> Kết quả</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        document.querySelectorAll('[data-qr]').forEach(el => {
            if (window.QRCode) new QRCode(el, { text: el.dataset.qr, width: 96, height: 96 });
        });
    </script>
}
