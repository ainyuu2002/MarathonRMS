@page
@model MarathonRMS.WebApp.Pages.Member.RegistrationChangesModel
@{ ViewData["Title"]="Đổi cự ly / chuyển suất"; }
<h1 class="h3">Đổi cự ly / chuyển suất</h1>
@if(Model.Registration is not null){<p class="text-secondary">@Model.Registration.EventName · @Model.Registration.CategoryName · @Model.Registration.RunnerName</p>}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="row g-3">
 <div class="col-lg-6"><div class="card card-body h-100"><h2 class="h5">Đổi cự ly</h2><p class="small text-secondary">Phí và chênh lệch giá được tính theo chính sách giải. Xuống cự ly không hoàn chênh lệch.</p>
 <form method="post" asp-page-handler="ChangeCategory"><input type="hidden" asp-for="Id"/><select asp-for="TargetCategoryId" class="form-select mb-3" required><option value="">Chọn cự ly mới</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name · @(c.CurrentPrice?.ToString("N0")??"—")đ · còn @c.RemainingSlots suất</option>}</select><button class="btn btn-primary">Xác nhận và thanh toán Mock</button></form></div></div>
 <div class="col-lg-6"><div class="card card-body h-100"><h2 class="h5">Chuyển suất</h2><p class="small text-secondary">Người nhận phải có tài khoản Member và hồ sơ chính chủ đầy đủ.</p>
 <form method="post" asp-page-handler="Transfer"><input type="hidden" asp-for="Id"/><label asp-for="RecipientEmail" class="form-label">Email người nhận</label><input asp-for="RecipientEmail" class="form-control mb-3" type="email" required/><button class="btn btn-outline-primary">Gửi yêu cầu</button></form></div></div>
</div>
