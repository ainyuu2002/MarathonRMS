@page
@model MarathonRMS.WebApp.Pages.Member.RefundsModel
@{
    ViewData["Title"] = "Hoàn tiền";
}

<h1 class="h3 mb-1">Hoàn tiền</h1>
<p class="text-secondary">Khi ban tổ chức hủy giải và hoàn tiền, khai tài khoản nhận tiền để BTC chuyển khoản.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.Items.Count == 0)
{
    <div class="text-center text-secondary border rounded py-5">
        <i class="bi bi-cash-stack fs-1"></i>
        <p class="mt-2 mb-0">Không có khoản hoàn tiền nào.</p>
    </div>
}
<div class="row g-3">
    @foreach (var r in Model.Items)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fw-semibold">@r.EventName</div>
                            <div class="small text-secondary">@r.CategoryName · @r.RunnerName</div>
                        </div>
                        <status-badge status="@(r.Status == "Pending" ? "RefundPending" : r.Status == "Completed" ? "Refunded" : "Rejected")" />
                    </div>
                    <div class="fs-5 fw-semibold mt-2">@r.Amount.ToString("N0")đ</div>
                    @if (r.Status == "Completed")
                    {
                        <div class="small text-success">Đã chuyển @r.ProcessedAt?.ToString("dd/MM/yyyy") – mã giao dịch @r.TransactionRef</div>
                    }
                    else if (r.Status == "Pending")
                    {
                        <form method="post" asp-page-handler="Bank" class="mt-2">
                            <input type="hidden" name="refundId" value="@r.Id" />
                            <label class="form-label small mb-1">Tài khoản nhận tiền (ngân hàng – số tài khoản – chủ tài khoản)</label>
                            <div class="input-group">
                                <input name="bankInfo" value="@r.BankInfo" class="form-control" maxlength="300" placeholder="Vietcombank – 0123456789 – NGUYEN VAN A" />
                                <button class="btn btn-primary">Lưu</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
