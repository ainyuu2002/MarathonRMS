@page
@model MarathonRMS.WebApp.Pages.Member.TransfersModel
@{ViewData["Title"]="Chuyển suất";}
<h1 class="h3">Chuyển suất</h1><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<h2 class="h5 mt-4">Yêu cầu đến</h2>
@foreach(var x in Model.Incoming){<div class="card card-body mb-2"><div><strong>@x.EventName</strong> · @x.CategoryName · @x.FromEmail</div><div class="small text-secondary">Phí @x.FeeAmount.ToString("N0")đ · @x.Status</div>@if(x.CanAccept){<form method="post" asp-page-handler="Accept" asp-route-id="@x.Id" class="mt-2"><div class="form-check"><input class="form-check-input" type="checkbox" name="waiverAccepted" value="true" required/><label class="form-check-label">Tôi chấp nhận miễn trừ trách nhiệm</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="healthDeclarationAccepted" value="true" required/><label class="form-check-label">Tôi cam kết đủ sức khỏe tham gia</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="healthDataConsent" value="true"/><label class="form-check-label">Đồng ý xử lý dữ liệu sức khỏe (bắt buộc nếu hồ sơ có dữ liệu này)</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="photoMarketingConsent" value="true"/><label class="form-check-label">Đồng ý sử dụng hình ảnh truyền thông</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="hideFromPublicList" value="true"/><label class="form-check-label">Ẩn khỏi danh sách công khai</label></div><button class="btn btn-primary btn-sm mt-2">Chấp nhận & thanh toán Mock</button></form><form method="post" asp-page-handler="Reject" asp-route-id="@x.Id" class="mt-2"><button class="btn btn-outline-danger btn-sm">Từ chối</button></form>}</div>}
@if(Model.Incoming.Count==0){<p class="text-secondary">Không có yêu cầu đến.</p>}
<h2 class="h5 mt-4">Yêu cầu đã gửi</h2>
@foreach(var x in Model.Outgoing){<div class="card card-body mb-2"><div><strong>@x.EventName</strong> · @x.CategoryName · @x.ToEmail</div><div class="small text-secondary">@x.Status</div>@if(x.CanCancel){<form method="post" asp-page-handler="Cancel" asp-route-id="@x.Id" class="mt-2"><button class="btn btn-outline-danger btn-sm">Hủy yêu cầu</button></form>}</div>}
@if(Model.Outgoing.Count==0){<p class="text-secondary">Chưa gửi yêu cầu nào.</p>}
