<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Marathon Race Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index"><i class="bi bi-flag-fill text-warning"></i> MRMS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Giải chạy</a></li>
                        @if (User.IsInRole(AppRoles.Member))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Member/Index">Của tôi</a></li>
                        }
                        @if (User.IsInRole(AppRoles.Staff) || User.IsInRole(AppRoles.Organizer))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Staff/Index">Vận hành</a></li>
                        }
                        @if (User.IsInRole(AppRoles.Organizer))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Organizer/Index">Ban tổ chức</a></li>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.SuperAdmin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Index">Quản trị</a></li>
                        }
                        @if (User.IsInRole(AppRoles.SuperAdmin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/SuperAdmin/Index">Hệ thống</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4" role="main">
        <partial name="_StatusMessage" model="TempData[nameof(BasePageModel.StatusMessage)] as string" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-secondary small">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 Marathon Race Management System – PRN232</span>
            <span>
                <a class="link-secondary" asp-page="/Legal/Terms">Điều khoản sử dụng</a> ·
                <a class="link-secondary" asp-page="/Legal/Privacy">Chính sách quyền riêng tư</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
