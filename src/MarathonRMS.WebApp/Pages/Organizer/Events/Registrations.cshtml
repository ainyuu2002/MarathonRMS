@page "{id:int}"
@model MarathonRMS.WebApp.Pages.Organizer.Events.RegistrationsModel
@{
    ViewData["Title"] = "Đăng ký – " + Model.Event.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Danh sách đăng ký</h1>
        <p class="text-secondary mb-0">@Model.Event.Name</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Danh sách giải</a>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">Mọi cự ly</option>
            @foreach (var c in Model.Event.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">Mọi trạng thái</option>
            @foreach (var s in MarathonRMS.WebApp.Pages.Organizer.Events.RegistrationsModel.Statuses)
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Họ tên, BIB, SĐT, số giấy tờ" />
    </div>
    <div class="col-md-2 d-grid"><button class="btn btn-primary"><i class="bi bi-search"></i> Lọc</button></div>
</form>

<div class="row g-4">
    <div class="@(Model.Editing is null ? "col-12" : "col-xl-8")">
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0 small">
                    <thead><tr><th>VĐV</th><th>Cự ly</th><th>BIB</th><th>Liên hệ</th><th>Áo</th><th class="text-end">Phí</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                    @if (Model.Data.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-secondary py-4">Không có đăng ký phù hợp.</td></tr>
                    }
                    @foreach (var r in Model.Data.Items)
                    {
                        <tr class="@(r.Id == Model.EditId ? "table-primary" : "")">
                            <td>
                                <div class="fw-semibold">@r.FullName</div>
                                <div class="text-secondary">@(r.Gender == "F" ? "Nữ" : "Nam") · @r.DateOfBirth.ToString("dd/MM/yyyy") · @r.Nationality</div>
                                <div class="text-secondary">@r.IdType @r.IdNumber</div>
                            </td>
                            <td>@r.CategoryName</td>
                            <td>@(r.BibNumber?.ToString() ?? "—")<div class="text-secondary">@r.BibName</div></td>
                            <td>@r.Phone<div class="text-secondary">@r.Email</div></td>
                            <td>@r.TShirtSize</td>
                            <td class="text-end">@r.FinalPrice.ToString("N0")</td>
                            <td>
                                <status-badge status="@r.Status" />
                                @if (r.RaceKitCollected) { <div class="text-success">Đã nhận kit</div> }
                            </td>
                            <td class="text-end">
                                <a asp-route-id="@Model.Id" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status"
                                   asp-route-keyword="@Model.Keyword" asp-route-p="@Model.P" asp-route-editId="@r.Id"
                                   class="btn btn-sm btn-outline-primary" title="Sửa thông tin đã khóa"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mt-2">
            <partial name="_Pager" model="PagerModel.From(Model.Data, new { id = Model.Id, categoryId = Model.CategoryId, status = Model.Status, keyword = Model.Keyword })" />
        </div>
    </div>

    @if (Model.Editing is { } e)
    {
        <div class="col-xl-4">
            <form method="post" asp-page-handler="LockedInfo" asp-route-id="@Model.Id" asp-route-editId="@e.Id"
                  asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status" asp-route-keyword="@Model.Keyword" asp-route-p="@Model.P"
                  class="card" novalidate>
                <div class="card-header fw-semibold">Sửa thông tin đã khóa – #@e.Id</div>
                <div class="card-body row g-3">
                    <div class="col-12 small text-secondary">Chỉ BTC sửa được các trường này; mỗi lần sửa ghi nhật ký kèm lý do.</div>
                    <div class="col-12">
                        <label asp-for="Input.FullName" class="form-label">Họ tên</label>
                        <input asp-for="Input.FullName" class="form-control" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Input.DateOfBirth" class="form-label">Ngày sinh</label>
                        <input asp-for="Input.DateOfBirth" type="date" class="form-control" />
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Input.Gender" class="form-label">Giới tính</label>
                        <select asp-for="Input.Gender" class="form-select">
                            <option value="M">Nam</option>
                            <option value="F">Nữ</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Input.IdType" class="form-label">Giấy tờ</label>
                        <select asp-for="Input.IdType" class="form-select">
                            <option value="">--</option>
                            <option value="CCCD">CCCD</option>
                            <option value="Passport">Hộ chiếu</option>
                            <option value="BirthCertificate">Giấy khai sinh</option>
                        </select>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Input.IdNumber" class="form-label">Số giấy tờ</label>
                        <input asp-for="Input.IdNumber" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Reason" class="form-label">Lý do sửa <span class="text-danger">*</span></label>
                        <textarea asp-for="Input.Reason" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Input.Reason" class="text-danger small"></span>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-route-id="@Model.Id" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status"
                       asp-route-keyword="@Model.Keyword" asp-route-p="@Model.P" class="btn btn-outline-secondary">Đóng</a>
                    <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button>
                </div>
            </form>
        </div>
    }
</div>
