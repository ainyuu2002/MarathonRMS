@page "{id:int}"
@model MarathonRMS.WebApp.Pages.Organizer.Events.AgeGroupsModel
@{
    ViewData["Title"] = "Nhóm tuổi";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div><h1 class="h3 mb-1">Nhóm tuổi</h1><p class="text-secondary mb-0">@Model.Event.Name</p></div>
    <a asp-page="Categories" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Thiết lập giải</a>
</div>
@if (Model.Event.ResultsStatus != "Draft")
{
    <div class="alert alert-warning py-2">BR-46: nhóm tuổi đã bị khóa vì kết quả không còn ở trạng thái Draft.</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card"><div class="card-header fw-semibold">Danh sách nhóm tuổi</div>
            @if (Model.AgeGroups.Count == 0) { <div class="card-body text-center text-secondary py-5">Chưa có nhóm tuổi.</div> }
            else
            {
                <div class="table-responsive"><table class="table align-middle mb-0">
                    <thead><tr><th>Nhóm</th><th>Phạm vi</th><th>Khoảng tuổi</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.AgeGroups)
                    {
                        <tr><td class="fw-semibold">@item.Name</td><td>@Model.CategoryName(item.CategoryId)</td><td>@item.MinAge–@(item.MaxAge?.ToString() ?? "∞")</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="AgeGroups" asp-route-id="@Model.Id" asp-route-ageGroupId="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Xóa nhóm tuổi @item.Name?');"><input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="ageGroupId" value="@item.Id" /><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>
                            </td></tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <form method="post" asp-page-handler="Save" class="card" novalidate>
            <input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="AgeGroupId" value="@Model.AgeGroupId" />
            <div class="card-header fw-semibold">@(Model.IsEditing ? "Sửa nhóm tuổi" : "Thêm nhóm tuổi")</div>
            <div class="card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3"><label asp-for="Input.CategoryId" class="form-label">Áp dụng cho</label><select asp-for="Input.CategoryId" class="form-select"><option value="">Mọi cự ly</option>@foreach (var category in Model.Event.Categories) { <option value="@category.Id">@category.Name</option> }</select></div>
                <div class="mb-3"><label asp-for="Input.Name" class="form-label">Tên nhóm</label><input asp-for="Input.Name" class="form-control" placeholder="16–29" /><span asp-validation-for="Input.Name" class="text-danger small"></span></div>
                <div class="row g-3"><div class="col-6"><label asp-for="Input.MinAge" class="form-label">Từ tuổi</label><input asp-for="Input.MinAge" type="number" min="0" max="120" class="form-control" /><span asp-validation-for="Input.MinAge" class="text-danger small"></span></div><div class="col-6"><label asp-for="Input.MaxAge" class="form-label">Đến tuổi</label><input asp-for="Input.MaxAge" type="number" min="0" max="120" class="form-control" /><span asp-validation-for="Input.MaxAge" class="text-danger small"></span></div></div>
            </div>
            <div class="card-footer text-end">@if (Model.IsEditing) { <a asp-page="AgeGroups" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Hủy sửa</a> }<button class="btn btn-primary" disabled="@(Model.Event.ResultsStatus != "Draft")"><i class="bi bi-check-lg"></i> Lưu nhóm tuổi</button></div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
