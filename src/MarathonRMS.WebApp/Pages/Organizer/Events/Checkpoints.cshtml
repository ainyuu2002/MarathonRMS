@page "{eventId:int}/{categoryId:int}"
@model MarathonRMS.WebApp.Pages.Organizer.Events.CheckpointsModel
@{
    ViewData["Title"] = "Checkpoint";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div><h1 class="h3 mb-1">Checkpoint – @Model.Category.Name</h1><p class="text-secondary mb-0">@Model.Event.Name</p></div>
    <a asp-page="Categories" asp-route-id="@Model.EventId" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cự ly</a>
</div>
@if (Model.Event.ResultsStatus != "Draft") { <div class="alert alert-warning py-2">BR-46: checkpoint đã bị khóa vì kết quả không còn ở trạng thái Draft.</div> }

<div class="row g-4">
    <div class="col-xl-7"><div class="card"><div class="card-header fw-semibold">Danh sách checkpoint</div>
        @if (Model.Checkpoints.Count == 0) { <div class="card-body text-center text-secondary py-5">Chưa có checkpoint. Cự ly bấm giờ cần Start và Finish trước khi mở đăng ký.</div> }
        else
        {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>#</th><th>Checkpoint</th><th>Km</th><th>Cut-off</th><th></th></tr></thead><tbody>
            @foreach (var item in Model.Checkpoints)
            {
                <tr><td>@item.Sequence</td><td><div class="fw-semibold">@item.Name</div><div class="small text-secondary">@item.Type · @item.StationType @(item.IsMandatory ? "· Bắt buộc" : "")</div></td><td>@item.DistanceKm.ToString("0.##")</td><td class="text-nowrap">@(item.CutOffAt?.ToString("dd/MM HH:mm") ?? "—")</td>
                    <td class="text-end text-nowrap"><a asp-page="Checkpoints" asp-route-eventId="@Model.EventId" asp-route-categoryId="@Model.CategoryId" asp-route-checkpointId="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Xóa checkpoint @item.Name?');"><input type="hidden" name="eventId" value="@Model.EventId" /><input type="hidden" name="categoryId" value="@Model.CategoryId" /><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr>
            }
            </tbody></table></div>
        }
    </div></div>
    <div class="col-xl-5"><form method="post" asp-page-handler="Save" class="card" novalidate>
        <input type="hidden" name="eventId" value="@Model.EventId" /><input type="hidden" name="categoryId" value="@Model.CategoryId" /><input type="hidden" name="checkpointId" value="@Model.CheckpointId" />
        <div class="card-header fw-semibold">@(Model.IsEditing ? "Sửa checkpoint" : "Thêm checkpoint")</div>
        <div class="card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div><div class="row g-3">
            <div class="col-8"><label asp-for="Input.Name" class="form-label">Tên</label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger small"></span></div>
            <div class="col-4"><label asp-for="Input.Sequence" class="form-label">Thứ tự</label><input asp-for="Input.Sequence" type="number" min="1" max="100" class="form-control" /><span asp-validation-for="Input.Sequence" class="text-danger small"></span></div>
            <div class="col-6"><label asp-for="Input.Type" class="form-label">Loại</label><select asp-for="Input.Type" class="form-select"><option value="Start">Start</option><option value="Split">Split</option><option value="Finish">Finish</option></select></div>
            <div class="col-6"><label asp-for="Input.StationType" class="form-label">Trạm</label><select asp-for="Input.StationType" class="form-select"><option value="None">Không</option><option value="Water">Nước</option><option value="Full">Đầy đủ</option><option value="Medical">Y tế</option></select></div>
            <div class="col-6"><label asp-for="Input.DistanceKm" class="form-label">Km</label><input asp-for="Input.DistanceKm" type="number" min="0" max="1000" step="0.01" class="form-control" /><span asp-validation-for="Input.DistanceKm" class="text-danger small"></span></div>
            <div class="col-6"><label asp-for="Input.CutOffAt" class="form-label">Giờ cut-off</label><input asp-for="Input.CutOffAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="Input.CutOffAt" class="text-danger small"></span></div>
            <div class="col-12"><div class="form-check form-switch"><input asp-for="Input.IsMandatory" class="form-check-input" /><label asp-for="Input.IsMandatory" class="form-check-label">Checkpoint bắt buộc</label></div></div>
            <div class="col-6"><label asp-for="Input.Latitude" class="form-label">Vĩ độ</label><input asp-for="Input.Latitude" type="number" step="0.000001" class="form-control" /><span asp-validation-for="Input.Latitude" class="text-danger small"></span></div>
            <div class="col-6"><label asp-for="Input.Longitude" class="form-label">Kinh độ</label><input asp-for="Input.Longitude" type="number" step="0.000001" class="form-control" /><span asp-validation-for="Input.Longitude" class="text-danger small"></span></div>
        </div></div>
        <div class="card-footer text-end">@if (Model.IsEditing) { <a asp-page="Checkpoints" asp-route-eventId="@Model.EventId" asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-secondary">Hủy sửa</a> }<button class="btn btn-primary" disabled="@(Model.Event.ResultsStatus != "Draft")"><i class="bi bi-check-lg"></i> Lưu checkpoint</button></div>
    </form></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
