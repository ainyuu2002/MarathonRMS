@page
@model MarathonRMS.WebApp.Pages.Organizer.Events.LifecycleModel
@{ViewData["Title"]="Hoãn / hủy giải";}
<h1 class="h3">Hoãn / hủy giải</h1><p class="text-secondary">@Model.Event?.Name · chính sách bất khả kháng: <strong>@Model.Policy?.ForceMajeurePolicy</strong></p><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="row g-3"><div class="col-lg-6"><div class="card card-body"><h2 class="h5">Hoãn giải</h2><p class="small text-secondary">Ngày thi, hạn đăng ký, đổi thông tin, đổi cự ly, chuyển suất, mức giá, checkpoint và lịch trình đều được dời cùng số ngày.</p><form method="post" asp-page-handler="Postpone"><input type="hidden" asp-for="Id"/><label asp-for="NewEventDate" class="form-label">Ngày thi mới</label><input asp-for="NewEventDate" type="date" class="form-control mb-3" required/><button class="btn btn-warning">Hoãn giải</button></form></div></div>
<div class="col-lg-6"><div class="card card-body"><h2 class="h5">Hủy giải</h2><p class="small text-secondary">Hệ thống áp dụng đúng phương án <strong>@Model.Policy?.ForceMajeurePolicy</strong>; nếu hoàn tiền, các khoản sẽ vào hàng chờ xử lý.</p><form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Hủy giải là thao tác không thể hoàn tác. Tiếp tục?');"><input type="hidden" asp-for="Id"/><label asp-for="Reason" class="form-label">Lý do</label><textarea asp-for="Reason" class="form-control mb-3" required maxlength="500"></textarea><button class="btn btn-danger">Hủy giải</button></form></div></div></div>
