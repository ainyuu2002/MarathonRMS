@page
@{
    ViewData["Title"] = "Ban tổ chức";
    var orgName = User.FindFirst("org_name")?.Value;
    // B: thay thẻ "Giải chạy của tôi" bằng trang danh sách giải khi làm UC-18 (Page = "/Organizer/Events/Index")
    var cards = new[]
    {
        new NavCard("Giải chạy của tôi", "Tạo và cập nhật thông tin các giải của ban tổ chức", "bi-trophy", "/Organizer/Events/Index"),
        new NavCard("Thông tin ban tổ chức", "Logo, giới thiệu, thông tin liên hệ của BTC", "bi-building", "/Organizer/Organization"),
        new NavCard("Thành viên BTC", "Mời / gỡ Staff phát race kit và bấm giờ", "bi-person-badge", "/Organizer/Staff"),
        new NavCard("Địa điểm", "Thêm địa điểm tổ chức để chọn khi tạo giải", "bi-geo-alt", "/Organizer/Venues"),
        new NavCard("Mã giảm giá", "Coupon cho VĐV và đối tác (ngân hàng, doanh nghiệp)", "bi-ticket-detailed", "/Organizer/Coupons"),
        new NavCard("Danh sách đăng ký", "Lọc VĐV theo giải, cự ly, trạng thái và sửa thông tin khóa", "bi-people", "/Organizer/Registrations"),
        new NavCard("Hoàn tiền", "Xử lý các khoản hoàn khi giải bị hủy", "bi-cash-coin", "/Organizer/Refunds"),
        new NavCard("Trang giới thiệu & album", "Khối nội dung, lịch trình, màu chủ đạo và album ảnh của từng giải", "bi-images", "/Organizer/EventContent"),
        new NavCard("Ngày thi & kết quả", "Gán BIB theo dải số của cự ly, tính kết quả từ dữ liệu bấm giờ", "bi-flag", "/Organizer/RaceDay/Index"),
    };
}
<h1 class="h3 mb-1">Ban tổ chức</h1>
<p class="text-secondary mb-4">@(orgName ?? "") – Xin chào @User.Identity?.Name</p>
<partial name="_NavCards" model="cards" />
