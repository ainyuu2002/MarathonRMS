@page
@model MarathonRMS.WebApp.Pages.SuperAdmin.AdminsModel
@{
    ViewData["Title"] = "Tài khoản quản trị";
}
<h1 class="h3 mb-3">Tài khoản quản trị</h1>
<p class="text-secondary small">Hệ thống luôn giữ ít nhất một SuperAdmin đang hoạt động. Không thể tự khóa hay tự đổi quyền tài khoản của mình.</p>

<div class="row g-4">
    <div class="col-lg-8">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Họ tên</th><th>Email</th><th>Quyền</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Admins)
                        {
                            var isSuper = a.Roles.Contains(AppRoles.SuperAdmin);
                            var isMe = a.Id == Model.CurrentUserId;
                            <tr>
                                <td>@a.FullName @if (isMe) { <span class="badge text-bg-light border">Bạn</span> }</td>
                                <td class="small">@a.Email</td>
                                <td>@(isSuper ? "SuperAdmin" : "Admin")</td>
                                <td><status-badge status="@(a.IsActive ? "Active" : "Inactive")" /></td>
                                <td class="text-end text-nowrap">
                                    @if (!isMe)
                                    {
                                        <form method="post" asp-page-handler="ChangeRole" asp-route-id="@a.Id" asp-route-role="@(isSuper ? "Admin" : "SuperAdmin")" class="d-inline">
                                            <button class="btn btn-sm btn-outline-secondary">@(isSuper ? "Hạ thành Admin" : "Nâng SuperAdmin")</button>
                                        </form>
                                        <form method="post" asp-page-handler="SetActive" asp-route-id="@a.Id" asp-route-isActive="@(!a.IsActive)" class="d-inline"
                                              onsubmit="return confirm('@(a.IsActive ? "Khóa" : "Mở khóa") tài khoản @a.Email?');">
                                            <button class="btn btn-sm @(a.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                <i class="bi @(a.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <form method="post" asp-page-handler="Create" class="card" novalidate>
            <div class="card-header">Tạo tài khoản Admin</div>
            <div class="card-body">
                <div class="mb-2">
                    <label asp-for="Input.FullName" class="form-label">Họ tên</label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.Password" class="form-label">Mật khẩu ban đầu</label>
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
            </div>
            <div class="card-footer text-end"><button class="btn btn-primary"><i class="bi bi-person-plus"></i> Tạo</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
