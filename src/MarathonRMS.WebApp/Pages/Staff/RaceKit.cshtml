@page
@model MarathonRMS.WebApp.Pages.Staff.RaceKitModel
@{
    ViewData["Title"] = "Phát race kit";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Phát race kit</h1>
        <p class="text-secondary mb-0">Tra cứu VĐV theo số BIB, mã QR, số giấy tờ hoặc số điện thoại.</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Vận hành</a>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

@if (Model.Events.Count == 0)
{
    <div class="text-center text-secondary border rounded py-5">
        <i class="bi bi-bag-check fs-1"></i>
        <p class="mt-2 mb-0">Ban tổ chức chưa có giải nào đã công bố.</p>
    </div>
}
else
{
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <select name="EventId" class="form-select" aria-label="Giải">
                @foreach (var e in Model.Events)
                {
                    <option value="@e.Id" selected="@(Model.EventId == e.Id)">@e.Name – @e.EventDate.ToString("dd/MM/yyyy")</option>
                }
            </select>
        </div>
        <div class="col-md-5">
            <input name="Keyword" value="@Model.Keyword" class="form-control" placeholder="BIB, mã QR, số giấy tờ hoặc số điện thoại" autofocus />
        </div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary"><i class="bi bi-search"></i> Tra cứu</button></div>
    </form>

    @if (Model.Searched && Model.Results.Count == 0)
    {
        <div class="alert alert-secondary">Không tìm thấy đăng ký phù hợp trong giải này.</div>
    }

    @foreach (var r in Model.Results)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="h5 mb-1">
                            @if (r.BibNumber is int bib) { <span class="badge text-bg-dark me-1">@bib</span> }
                            @r.FullName
                        </div>
                        <div class="small text-secondary">
                            @r.CategoryName · Áo @r.TShirtSize · Giấy tờ @(r.IdNumberMasked ?? "—")
                            @if (r.IsMinor)
                            {
                                <span> · Cần đồng ý giám hộ: @(r.HasGuardianConsent ? "đã có" : "chưa có")</span>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        <status-badge status="@r.Status" />
                        @if (r.PickedUp)
                        {
                            <div class="small text-success mt-1"><i class="bi bi-check-circle"></i> Đã nhận kit @r.PickedUpAt?.ToString("HH:mm dd/MM")</div>
                        }
                    </div>
                </div>
                @if (r.Warnings.Count > 0)
                {
                    <ul class="small text-danger mb-0 mt-2 ps-3">
                        @foreach (var w in r.Warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}
