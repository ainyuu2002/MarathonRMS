@page
@{
    ViewData["Title"] = "Vận hành ngày thi";
    var orgName = User.FindFirst("org_name")?.Value;
    var cards = new[]
    {
        new NavCard("Phát race kit", "Tra cứu VĐV theo BIB, mã QR, giấy tờ hoặc số điện thoại và phát kit", "bi-bag-check", "/Staff/RaceKit"),
        new NavCard("Bấm giờ", "Nhập thời gian tại checkpoint, ghi nhận bỏ cuộc", "bi-stopwatch", null),
    };
}
<h1 class="h3 mb-1">Vận hành ngày thi</h1>
<p class="text-secondary mb-4">@(orgName ?? "") – Xin chào @User.Identity?.Name</p>
<partial name="_NavCards" model="cards" />
