@page
@model MarathonRMS.WebApp.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Đăng ký tài khoản</h1>
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label">Họ và tên</label>
                        <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Tối thiểu 8 ký tự, có chữ hoa, chữ thường và chữ số.</div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    @* BR-09: ô đồng ý KHÔNG được tick sẵn (Luật 91/2025 – Điều 9) *@
                    <div class="form-check mb-2">
                        <input asp-for="Input.AcceptTerms" class="form-check-input" />
                        <label asp-for="Input.AcceptTerms" class="form-check-label">
                            Tôi đồng ý <a asp-page="/Legal/Terms" target="_blank">Điều khoản sử dụng</a>
                        </label>
                        <div><span asp-validation-for="Input.AcceptTerms" class="text-danger small"></span></div>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Input.AcceptPrivacy" class="form-check-input" />
                        <label asp-for="Input.AcceptPrivacy" class="form-check-label">
                            Tôi đồng ý <a asp-page="/Legal/Privacy" target="_blank">Chính sách quyền riêng tư</a>
                        </label>
                        <div><span asp-validation-for="Input.AcceptPrivacy" class="text-danger small"></span></div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Tạo tài khoản</button>
                </form>
                <p class="text-center small mt-3 mb-0">Đã có tài khoản? <a asp-page="/Account/Login">Đăng nhập</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // [Range(true,true)] cho checkbox: jQuery unobtrusive cần so sánh theo trạng thái checked
        $.validator.addMethod("range", function (value, element, param) {
            if (element.type === "checkbox") return element.checked;
            return $.validator.methods.range.call(this, value, element, param);
        });
    </script>
}
