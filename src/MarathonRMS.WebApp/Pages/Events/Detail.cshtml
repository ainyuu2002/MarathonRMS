@page "{id:int}/{slug?}"
@model MarathonRMS.WebApp.Pages.Events.DetailModel
@{
    ViewData["Title"] = Model.Event.Name;
}

<a asp-page="/Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Danh sách giải</a>
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

@if (Model.Event.Status == "Cancelled")
{
    <div class="alert alert-danger"><strong>Giải đã bị hủy.</strong> @Model.Event.CancelReason
        <div class="small mt-1">VĐV đã thanh toán xem tình trạng hoàn tiền tại <a asp-page="/Member/Refunds">Hoàn tiền của tôi</a>.</div>
    </div>
}
else if (Model.Event.PostponedFromDate is DateOnly postponedFrom)
{
    <div class="alert alert-warning">Giải đã <strong>dời</strong> từ @postponedFrom.ToString("dd/MM/yyyy") sang @Model.Event.EventDate.ToString("dd/MM/yyyy"). Đăng ký của bạn vẫn giữ nguyên.</div>
}

<section class="card overflow-hidden mb-4">
    @if (!string.IsNullOrWhiteSpace(Model.Event.BannerUrl))
    {
        <img src="@Model.Event.BannerUrl" alt="Ảnh @Model.Event.Name" class="w-100" style="max-height:420px;object-fit:cover" />
    }
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="mb-2"><status-badge status="@Model.Event.Status" /></div>
                <h1 class="display-6 fw-semibold mb-2">@Model.Event.Name</h1>
                <div class="text-secondary"><i class="bi bi-building"></i> @Model.Event.OrganizationName</div>
            </div>
            <div class="text-md-end">
                <div class="fw-semibold"><i class="bi bi-calendar-event"></i> @Model.Event.EventDate.ToString("dd/MM/yyyy")@(Model.Event.EndDate == Model.Event.EventDate ? "" : $" – {Model.Event.EndDate:dd/MM/yyyy}")</div>
                <div class="text-secondary"><i class="bi bi-geo-alt"></i> @Model.Event.VenueName, @Model.Event.City</div>
                <div class="small text-secondary">@Model.Event.VenueAddress</div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Event.DescriptionHtml))
        {
            <div class="mt-4">@Html.Raw(Model.Event.DescriptionHtml)</div>
        }
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="h4 mb-0">Cự ly và mức giá</h2>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-page="/Events/Runners" asp-route-id="@Model.Event.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-people"></i> Danh sách VĐV</a>
                @if (Model.Event.ResultsStatus is "Provisional" or "Official")
                {
                    <a asp-page="/Results/Index" asp-route-eventId="@Model.Event.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-trophy"></i> Kết quả</a>
                }
            </div>
        </div>
        @if (Model.Event.Categories.Count == 0)
        {
            <div class="card card-body text-secondary">Ban tổ chức chưa công bố cự ly.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var category in Model.Event.Categories)
                {
                    <div class="col-md-6">
                        <article class="card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div><h3 class="h5 mb-1">@category.Name</h3><span class="badge text-bg-light">@category.Discipline</span></div>
                                    <div class="text-end"><div class="fs-5 fw-semibold text-primary">@DetailModel.PriceText(category.CurrentPrice)</div><div class="small text-secondary">@category.CurrentPriceTierName</div></div>
                                </div>
                                <dl class="row small mt-3 mb-0">
                                    <dt class="col-5">Cự ly</dt><dd class="col-7">@category.DistanceKm.ToString("0.##") km</dd>
                                    <dt class="col-5">Xuất phát</dt><dd class="col-7">@category.StartAt.ToString("dd/MM/yyyy HH:mm")</dd>
                                    <dt class="col-5">Độ tuổi</dt><dd class="col-7">@DetailModel.AgeText(category)</dd>
                                    <dt class="col-5">Bấm giờ</dt><dd class="col-7">@(category.IsTimed ? "Có" : "Không")</dd>
                                    @if (category.CutOffMinutes is int cutOff)
                                    {
                                        <dt class="col-5">Cut-off</dt><dd class="col-7">@cutOff phút</dd>
                                    }
                                    <dt class="col-5">Còn lại</dt><dd class="col-7"><strong>@category.RemainingSlots.ToString("N0")</strong> / @category.Capacity.ToString("N0") suất</dd>
                                </dl>
                                @if (Model.Event.Status == "RegistrationOpen" && category.RemainingSlots > 0 && category.CurrentPrice is not null)
                                {
                                    if (User.IsInRole(AppRoles.Member))
                                    {
                                        <a asp-page="/Member/Register" asp-route-categoryId="@category.Id" class="btn btn-primary w-100 mt-3">
                                            <i class="bi bi-ticket-perforated"></i> Đăng ký cự ly
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-page="/Account/Login" asp-route-returnUrl="/Member/Register/@category.Id" class="btn btn-outline-primary w-100 mt-3">
                                            Đăng nhập để đăng ký
                                        </a>
                                    }
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
    <aside class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Thời gian đăng ký</div>
            <div class="card-body small">
                <div><i class="bi bi-unlock"></i> Mở: <strong>@Model.Event.RegistrationOpenAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                <div class="mt-2"><i class="bi bi-lock"></i> Đóng: <strong>@Model.Event.RegistrationCloseAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Event.EmergencyPhone) || !string.IsNullOrWhiteSpace(Model.Event.InsuranceNote))
        {
            <div class="card">
                <div class="card-header fw-semibold">Thông tin an toàn</div>
                <div class="card-body small">
                    @if (!string.IsNullOrWhiteSpace(Model.Event.EmergencyPhone)) { <div><i class="bi bi-telephone"></i> @Model.Event.EmergencyPhone</div> }
                    @if (!string.IsNullOrWhiteSpace(Model.Event.InsuranceNote)) { <div class="mt-2">@Model.Event.InsuranceNote</div> }
                </div>
            </div>
        }
    </aside>
</div>

<section class="mb-4">
    <h2 class="h4 mb-3">Chính sách giải</h2>
    <div class="row g-3">
        <div class="col-md-6 col-xl-3"><div class="card h-100 card-body"><div class="small text-secondary">Chuyển nhượng</div><div class="fw-semibold mt-1">@DetailModel.TransferText(Model.Event.Policy)</div></div></div>
        <div class="col-md-6 col-xl-3"><div class="card h-100 card-body"><div class="small text-secondary">Đổi cự ly</div><div class="fw-semibold mt-1">Tối đa @Model.Event.Policy.MaxCategoryChanges lần · phí @Model.Event.Policy.CategoryChangeFee.ToString("N0")đ</div></div></div>
        <div class="col-md-6 col-xl-3"><div class="card h-100 card-body"><div class="small text-secondary">Xếp hạng</div><div class="fw-semibold mt-1">@DetailModel.RankingText(Model.Event.Policy.OverallRankingBasis)</div></div></div>
        <div class="col-md-6 col-xl-3"><div class="card h-100 card-body"><div class="small text-secondary">Bất khả kháng</div><div class="fw-semibold mt-1">@DetailModel.ForceMajeureText(Model.Event.Policy.ForceMajeurePolicy)</div></div></div>
    </div>
</section>

@if (Model.Event.AgeGroups.Count > 0)
{
    <section class="mb-4">
        <h2 class="h4 mb-3">Nhóm tuổi</h2>
        <div class="table-responsive card"><table class="table align-middle mb-0"><thead><tr><th>Nhóm</th><th>Áp dụng</th><th>Khoảng tuổi</th></tr></thead><tbody>
        @foreach (var group in Model.Event.AgeGroups)
        {
            <tr><td class="fw-semibold">@group.Name</td><td>@Model.AgeGroupScope(group)</td><td>@group.MinAge–@(group.MaxAge?.ToString() ?? "∞")</td></tr>
        }
        </tbody></table></div>
    </section>
}

<section class="mb-4">
    <h2 class="h4 mb-3">Giới thiệu và lịch trình</h2>
    <partial name="_EventContent" model="Model.PublicContent" />
</section>

@if (Model.PublicContent.Gallery.Count > 0)
{
    <section>
        <h2 class="h4 mb-3">Album ảnh</h2>
        <partial name="_EventGallery" model="Model.PublicContent.Gallery" />
    </section>
}
